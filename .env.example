# Azure subscription and deployment defaults.
# Copy to .env and adjust values as needed; scripts also accept environment variables.
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=uksouth
PROJECT_NAME=coffee_now
PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-4o
AGENT_NAME=coffee-agent

# Agent runtime options.
# VECTOR_STORE_MODE can be reuse, create, or ask.
VECTOR_STORE_MODE=ask
VECTOR_STORE_ID=
VECTOR_STORE_NAME=CoffeeStores
DOCUMENTS_GLOB=work/documents/*.md

# Terraform remote state. Keep this stable when switching app resource regions.
TF_STATE_RESOURCE_GROUP=rg-coffee-now-tfstate
TF_STATE_LOCATION=uksouth
TF_STATE_STORAGE_ACCOUNT=
TF_STATE_CONTAINER=tfstate
TF_STATE_KEY=coffee-now.tfstate

# Optional Terraform variables.
TF_VAR_resource_group_name=rg-coffee-now
TF_VAR_foundry_account_name=coffee-dw-foundry
TF_VAR_foundry_project_name=coffee_now
TF_VAR_deploy_model=true
TF_VAR_model_deployment_name=gpt-4o
TF_VAR_model_name=gpt-4o
TF_VAR_model_version=2024-11-20
TF_VAR_model_sku_name=GlobalStandard
TF_VAR_model_capacity=1
